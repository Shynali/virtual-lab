# Виртуалды химия зертханасы
Options -Indexes
<FilesMatch "^(lib|config)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|gs|py|lock)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
